{"kind":"textbox","id":"sh/32lszqtc","slide":2,"text":"Why automate the search?","textPreview":"Why automate the search?","textChars":24,"textLines":1,"bbox":[42,36,900,56]}
{"kind":"textbox","id":"sh/sneloj2t","slide":2,"text":"Modified gravity has a huge legal-looking theory space; most candidates are not physically usable.","textPreview":"Modified gravity has a huge legal-looking theory space; most candidates are not physically usable.","textChars":98,"textLines":1,"bbox":[42,94,930,36]}
